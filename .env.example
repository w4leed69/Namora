# ── Server ──
PORT=3000
# Public HTTPS URL of this server (used for payment links and webhooks)
PUBLIC_URL=https://your-domain.com
BRAND_NAME=Namora
SUPPORT_CONTACT=support@your-domain.com
DATA_FILE=data/db.json

# ── WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp → API Setup) ──
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any random string; paste the same value into the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=change-me
# App settings → Basic → App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v24.0
# Your WhatsApp business number, digits only (for "Back to WhatsApp" links)
WHATSAPP_DISPLAY_NUMBER=

# ── Flights: mock | duffel ──
FLIGHT_PROVIDER=mock
# duffel_test_... for sandbox, duffel_live_... for real tickets
DUFFEL_ACCESS_TOKEN=
CABIN_CLASS=economy
MAX_RESULTS=10
# Currency used by the mock provider
MOCK_CURRENCY=USD

# ── Payments: mock | stripe ──
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Your margin (added to the airline fare) ──
MARKUP_PERCENT=0
SERVICE_FEE=0
